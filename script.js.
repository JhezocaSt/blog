document.addEventListener('DOMContentLoaded', () => {
    
    // ==========================================
    // 1. LÓGICA DO BOTÃO DE CURTIDA MÁGICO
    // ==========================================
    const likeButton = document.getElementById('likeButton');
    const likeCountEl = document.getElementById('likeCount');

    // Recupera curtidas do localStorage para não perder ao atualizar a página
    let currentLikes = parseInt(localStorage.getItem('vlog_likes')) || 0;
    let isLiked = localStorage.getItem('vlog_user_liked') === 'true';

    // Atualiza a interface com o estado salvo
    likeCountEl.textContent = currentLikes;
    if (isLiked) {
        likeButton.classList.add('liked');
    }

    likeButton.addEventListener('click', (e) => {
        if (!isLiked) {
            currentLikes++;
            isLiked = true;
            likeButton.classList.add('liked');
            createMagicSparkles(e.clientX, e.clientY); // Solta faíscas mágicas
        } else {
            currentLikes--;
            isLiked = false;
            likeButton.classList.remove('liked');
        }

        // Atualiza ecran e guarda no navegador
        likeCountEl.textContent = currentLikes;
        localStorage.setItem('vlog_likes', currentLikes);
        localStorage.setItem('vlog_user_liked', isLiked);
    });

    // Função que cria partículas mágicas ao clicar no botão
    function createMagicSparkles(x, y) {
        const particleCount = 12;
        for (let i = 0; i < particleCount; i++) {
            const particle = document.createElement('span');
            particle.classList.add('magic-particle');
            
            // Define posições aleatórias para a explosão de luz
            const destinationX = (Math.random() - 0.5) * 120;
            const destinationY = (Math.random() - 0.5) * 120;
            
            particle.style.left = `${x}px`;
            particle.style.top = `${y}px`;
            particle.style.setProperty('--dx', `${destinationX}px`);
            particle.style.setProperty('--dy', `${destinationY}px`);

            document.body.appendChild(particle);

            setTimeout(() => {
                particle.remove();
            }, 800);
        }
    }


    // ==========================================
    // 2. MODO LUMOS / NOX (Alternador de Tema)
    // ==========================================
    const themeToggleBtn = document.getElementById('themeToggle');
    
    themeToggleBtn.addEventListener('click', () => {
        document.body.classList.toggle('lumos-mode');
        
        if (document.body.classList.contains('lumos-mode')) {
            themeToggleBtn.innerHTML = '<span>🌙</span> Nox';
        } else {
            themeToggleBtn.innerHTML = '<span>🪄</span> Lumos';
        }
    });


    // ==========================================
    // 3. EFEITO DE TOQUE MÁGICO NA TELA
    // ==========================================
    document.addEventListener('click', (e) => {
        // Não dispara se for clique no botão de curtida
        if (e.target.closest('#likeButton')) return;

        const spark = document.createElement('div');
        spark.className = 'wand-spark';
        spark.style.left = `${e.clientX}px`;
        spark.style.top = `${e.clientY}px`;
        document.body.appendChild(spark);

        setTimeout(() => spark.remove(), 600);
    });
});